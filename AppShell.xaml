<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CaffeineTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:CaffeineTracker"
    Title="CaffeineTracker">

    <TabBar>
        <ShellContent
            Title="Tracker"
            ContentTemplate="{DataTemplate local:TrackerPage}"
            Route="TrackerPage" />
        <ShellContent
            Title="Drinks"
            ContentTemplate="{DataTemplate local:DrinkListPage}"
            Route="DrinkListPage"/>
        <ShellContent
            Title="History"
            ContentTemplate="{DataTemplate local:HistoryPage}"
            Route="HistoryPage"/>
    </TabBar>
</Shell>
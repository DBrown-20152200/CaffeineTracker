<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaffeineTracker.HistoryPage"
             Title="HistoryPage"
             NavigatedTo="HistoryPage_NavigatedTo">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="15*"/>
            <RowDefinition Height="70*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25*"/>
            <ColumnDefinition Width="50*"/>
            <ColumnDefinition Width="25*"/>
        </Grid.ColumnDefinitions>

        <Label Text="Caffeine History" 
               FontSize="24" 
               Grid.Row="0" 
               Grid.Column="1" 
               HorizontalTextAlignment="Center"/>

        <Label Text="Date" FontSize="18" Grid.Row="1" Grid.Column="1"/>
        <Label Text="Caffeine Consumed (mg)" FontSize="18" Grid.Row="1" Grid.Column="1" HorizontalTextAlignment="End"/>

        <ListView x:Name="CaffeineHistoryList" Grid.Row="2" Grid.Column="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid RowDefinitions="*" ColumnDefinitions="*">
                            <Label Text="{Binding DateConsumed}" Grid.Row="0" Grid.Column="0" HorizontalTextAlignment="Start"/>
                            <Label Text="{Binding CaffeineConsumed}" Grid.Row="0" Grid.Column="0" HorizontalTextAlignment="End"/>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentPage>